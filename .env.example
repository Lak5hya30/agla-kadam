# Copy this file to .env.local and fill in a value to enable LIVE OpenAI analysis.
# WITHOUT a key, the app still works fully using cached synthetic-demo analysis fixtures.
# This key is used ONLY server-side (in /src/app/api routes). It is never exposed to the browser.

OPENAI_API_KEY=

# Optional: override the default model. Defaults to a small, fast, structured-output-capable model.
OPENAI_MODEL=gpt-4o-mini

# Demo appeal window in days. The deterministic policy engine uses this to decide
# whether the (synthetic) appeal route is available. Purely for the demo.
DEMO_APPEAL_WINDOW_DAYS=30
